---
import { Image } from "astro:assets";
import { site } from "../data/site";
import logo from "../assets/logo.png";

const year = new Date().getFullYear();
---

<footer class="border-t border-navy-900/10 bg-navy-950 text-navy-100">
  <div class="mx-auto grid max-w-6xl gap-10 px-6 py-14 md:grid-cols-3">
    <div>
      <div class="flex items-center gap-3">
        <Image src={logo} alt={`${site.firmName} logo`} width={44} height={44} class="h-11 w-11 invert" />
        <span class="font-display text-lg font-semibold text-cream-100">{site.firmName}</span>
      </div>
      <p class="mt-3 text-sm text-navy-100/80">{site.tagline}</p>
    </div>

    <div>
      <h3 class="font-display text-sm font-semibold tracking-wide text-gold-400 uppercase">Contact</h3>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href={site.phoneHref} class="hover:text-gold-400">{site.phone}</a></li>
        <li><a href={`mailto:${site.email}`} class="hover:text-gold-400">{site.email}</a></li>
        <li class="text-navy-100/80">{site.address}</li>
        <li class="text-navy-100/80">{site.hours}</li>
      </ul>
    </div>

    <div>
      <h3 class="font-display text-sm font-semibold tracking-wide text-gold-400 uppercase">Explore</h3>
      <ul class="mt-3 space-y-2 text-sm">
        <li><a href="/practice-areas/" class="hover:text-gold-400">Practice Areas</a></li>
        <li><a href="/about/" class="hover:text-gold-400">About Alexander</a></li>
        <li><a href="/blog/" class="hover:text-gold-400">Blog</a></li>
        <li><a href="/faq/" class="hover:text-gold-400">FAQ</a></li>
        <li><a href="/contact/" class="hover:text-gold-400">Contact</a></li>
      </ul>
    </div>
  </div>

  <div class="border-t border-navy-100/10">
    <div class="mx-auto flex max-w-6xl flex-col gap-2 px-6 py-6 text-xs text-navy-100/70 md:flex-row md:items-center md:justify-between">
      <p>&copy; {year} {site.firmName}. All rights reserved.</p>
      <p>Attorney advertising. Prior results do not guarantee a similar outcome. This site does not create an attorney-client relationship.</p>
    </div>
  </div>
</footer>
