---
import { site } from "../data/site";

const navLinks = [
  { href: "/about/", label: "About" },
  { href: "/practice-areas/", label: "Practice Areas" },
  { href: "/blog/", label: "Blog" },
  { href: "/faq/", label: "FAQ" },
  { href: "/contact/", label: "Contact" },
];

const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 border-b border-navy-900/10 bg-cream-100/95 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-4">
    <a href="/" class="flex items-center gap-3 text-navy-900">
      <img
        src="/images/logo.svg"
        alt={`${site.firmName} logo`}
        width="52"
        height="52"
        class="h-12 w-12 shrink-0"
      />
      <span class="flex flex-col leading-tight">
        <span class="font-display text-lg font-semibold tracking-tight">{site.firmName}</span>
        <span class="text-xs tracking-[0.15em] text-gold-700 uppercase">{site.tagline}</span>
      </span>
    </a>

    <nav class="hidden items-center gap-8 md:flex">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class:list={[
              "text-sm font-medium tracking-wide transition-colors hover:text-gold-700",
              currentPath === link.href ? "text-gold-700" : "text-navy-800",
            ]}
          >
            {link.label}
          </a>
        ))
      }
      <a
        href={site.phoneHref}
        class="rounded-sm bg-navy-900 px-5 py-2.5 text-sm font-semibold text-cream-100 transition-colors hover:bg-navy-700"
      >
        Call {site.phone}
      </a>
    </nav>

    <details class="relative md:hidden">
      <summary class="list-none rounded-sm border border-navy-900/20 p-2 text-navy-900 [&::-webkit-details-marker]:hidden">
        <span class="sr-only">Open menu</span>
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-6 w-6">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
      </summary>
      <nav class="absolute right-0 mt-2 flex w-48 flex-col gap-1 rounded-sm border border-navy-900/10 bg-cream-100 p-3 shadow-lg">
        {
          navLinks.map((link) => (
            <a href={link.href} class="rounded-sm px-3 py-2 text-sm font-medium text-navy-800 hover:bg-navy-900/5">
              {link.label}
            </a>
          ))
        }
        <a href={site.phoneHref} class="mt-1 rounded-sm bg-navy-900 px-3 py-2 text-center text-sm font-semibold text-cream-100">
          Call {site.phone}
        </a>
      </nav>
    </details>
  </div>
</header>
