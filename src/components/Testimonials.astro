---
import { testimonials } from "../data/site";

interface Props {
  limit?: number;
}

const { limit } = Astro.props;
const items = limit ? testimonials.slice(0, limit) : testimonials;
---

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  {
    items.map((t) => (
      <figure class="flex flex-col rounded-sm border border-navy-900/10 bg-cream-100 p-6">
        <span class="font-display text-4xl leading-none text-gold-500" aria-hidden="true">
          &ldquo;
        </span>
        <blockquote class="mt-1 flex-1 text-sm leading-relaxed text-ink-700">{t.quote}</blockquote>
        <figcaption class="mt-4 text-sm font-semibold text-navy-900">&mdash; {t.author}</figcaption>
      </figure>
    ))
  }
</div>
