---
import type { Faq } from "../data/site";

interface Props {
  faqs: Faq[];
  headingLevel?: "h2" | "h3";
}

const { faqs, headingLevel = "h3" } = Astro.props;
const HeadingTag = headingLevel;
---

<div class="space-y-4">
  {
    faqs.map((faq, i) => (
      <details class="group rounded-sm border border-navy-900/10 bg-cream-200 p-6 open:bg-cream-100" open={i === 0}>
        <summary class="flex cursor-pointer list-none items-start justify-between gap-4 font-display font-semibold text-navy-900 [&::-webkit-details-marker]:hidden">
          <HeadingTag class="text-lg">{faq.q}</HeadingTag>
          <span class="mt-0.5 shrink-0 text-gold-700 group-open:hidden" aria-hidden="true">+</span>
          <span class="mt-0.5 hidden shrink-0 text-gold-700 group-open:inline" aria-hidden="true">&minus;</span>
        </summary>
        <p class="mt-3 leading-relaxed text-ink-700">{faq.a}</p>
      </details>
    ))
  }
</div>
