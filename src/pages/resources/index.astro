---
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";

const resources = [
  {
    href: "/resources/living-trust-vs-will/",
    title: "Living Trust vs. Will",
    description: "Which one actually fits your Wisconsin family? A clear, side-by-side comparison.",
  },
  {
    href: "/resources/probate-costs-wisconsin/",
    title: "Probate Costs in Wisconsin",
    description: "What probate actually costs your family in time, money, and privacy — and how to avoid it.",
  },
  {
    href: "/resources/what-happens-without-a-plan/",
    title: "What Happens Without a Plan",
    description: "What Wisconsin law decides for your family if you never get around to planning.",
  },
  {
    href: "/resources/estate-planning-checklist/",
    title: "Estate Planning Checklist",
    description: "A practical, no-jargon checklist to see where your family stands today.",
  },
  {
    href: "/blog/",
    title: "Blog",
    description: "Plain-English articles on estate planning topics for Wisconsin families.",
  },
  {
    href: "/faq/",
    title: "Frequently Asked Questions",
    description: "Straight answers to the questions we hear most often.",
  },
];
---

<BaseLayout
  title="Estate Planning Resources for Wisconsin Families"
  description="Free estate planning guides for Wisconsin families: living trust vs. will, probate costs, what happens without a plan, and an estate planning checklist."
>
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <p class="text-sm font-semibold tracking-[0.2em] text-gold-700 uppercase">Resources</p>
    <h1 class="font-display mt-3 max-w-2xl text-4xl font-semibold text-navy-900">
      Plain-English Answers to Your Estate Planning Questions
    </h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-700">
      No jargon, no scare tactics — just clear guides to help you understand your options before
      you ever have to make a decision.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {
        resources.map((r) => (
          <a
            href={r.href}
            class="group flex flex-col rounded-sm border border-navy-900/10 bg-cream-200 p-7 transition-shadow hover:shadow-lg"
          >
            <h2 class="font-display text-lg font-semibold text-navy-900 group-hover:text-gold-700">{r.title}</h2>
            <p class="mt-2 flex-1 text-sm text-ink-700">{r.description}</p>
            <span class="mt-3 inline-block text-sm font-semibold text-gold-700">Read more &rarr;</span>
          </a>
        ))
      }
    </div>

    <div class="mt-16">
      <CtaBanner
        heading="Have a Question That's Not Answered Here?"
        subtext="Skip the research and get a direct answer. Schedule a free, no-pressure consultation."
      />
    </div>
  </section>
</BaseLayout>
