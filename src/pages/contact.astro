---
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";
---

<BaseLayout
  title="Contact"
  description={`Get in touch with ${site.firmName} to schedule an estate planning consultation.`}
>
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <p class="text-sm font-semibold tracking-[0.2em] text-gold-700 uppercase">Contact</p>
    <h1 class="font-display mt-3 text-4xl font-semibold text-navy-900">Let's talk about your plan</h1>
    <p class="mt-4 max-w-2xl text-ink-700">
      Reach out by phone or email, or send a message below and {site.attorneyName} will get back
      to you.
    </p>

    <div class="mt-12 grid gap-10 md:grid-cols-[1fr_1.2fr]">
      <div class="space-y-6">
        <div class="rounded-sm border border-navy-900/10 bg-cream-200 p-6">
          <h2 class="font-display text-sm font-semibold tracking-wide text-navy-900 uppercase">Phone</h2>
          <a href={site.phoneHref} class="mt-2 block text-lg font-semibold text-gold-700 hover:text-gold-600">
            {site.phone}
          </a>
        </div>
        <div class="rounded-sm border border-navy-900/10 bg-cream-200 p-6">
          <h2 class="font-display text-sm font-semibold tracking-wide text-navy-900 uppercase">Email</h2>
          <a href={`mailto:${site.email}`} class="mt-2 block text-lg font-semibold text-gold-700 hover:text-gold-600">
            {site.email}
          </a>
        </div>
        <div class="rounded-sm border border-navy-900/10 bg-cream-200 p-6">
          <h2 class="font-display text-sm font-semibold tracking-wide text-navy-900 uppercase">Office Hours</h2>
          <p class="mt-2 text-ink-700">{site.hours}</p>
        </div>
        <div class="rounded-sm border border-navy-900/10 bg-cream-200 p-6">
          <h2 class="font-display text-sm font-semibold tracking-wide text-navy-900 uppercase">Location</h2>
          <p class="mt-2 text-ink-700">{site.address}</p>
        </div>
      </div>

      <form class="space-y-5 rounded-sm border border-navy-900/10 bg-cream-100 p-8 shadow-sm" data-contact-form>
        <div>
          <label for="name" class="block text-sm font-semibold text-navy-900">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            class="mt-2 w-full rounded-sm border border-navy-900/20 bg-cream-100 px-4 py-2.5 text-ink-900 focus:border-gold-600 focus:ring-1 focus:ring-gold-600 focus:outline-none"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-semibold text-navy-900">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            class="mt-2 w-full rounded-sm border border-navy-900/20 bg-cream-100 px-4 py-2.5 text-ink-900 focus:border-gold-600 focus:ring-1 focus:ring-gold-600 focus:outline-none"
          />
        </div>
        <div>
          <label for="phone" class="block text-sm font-semibold text-navy-900">Phone (optional)</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            class="mt-2 w-full rounded-sm border border-navy-900/20 bg-cream-100 px-4 py-2.5 text-ink-900 focus:border-gold-600 focus:ring-1 focus:ring-gold-600 focus:outline-none"
          />
        </div>
        <div>
          <label for="message" class="block text-sm font-semibold text-navy-900">How can we help?</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="mt-2 w-full rounded-sm border border-navy-900/20 bg-cream-100 px-4 py-2.5 text-ink-900 focus:border-gold-600 focus:ring-1 focus:ring-gold-600 focus:outline-none"
          ></textarea>
        </div>
        <button
          type="submit"
          class="w-full rounded-sm bg-navy-900 px-6 py-3 text-sm font-semibold text-cream-100 transition-colors hover:bg-navy-700"
        >
          Send Message
        </button>
        <p class="text-xs text-ink-500">
          This form currently needs to be connected to an email or form-handling service (e.g.
          Formspree, Netlify Forms, or a mailto endpoint) before it will actually deliver
          submissions — see the note left for you in this file.
        </p>
      </form>
    </div>
  </section>
</BaseLayout>

<!--
  NOTE FOR ALEX: This form doesn't submit anywhere yet. Since this is a static Astro site,
  you'll need to wire it up to a form backend, for example:
    - Formspree (https://formspree.io) — add action="https://formspree.io/f/yourFormId" method="POST" to the <form>
    - Netlify Forms — add data-netlify="true" to the <form> if you deploy to Netlify
    - A simple mailto: fallback (less reliable, but zero setup)
  Let me know which you'd prefer and I can wire it up.
-->
