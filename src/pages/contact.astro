---
import BaseLayout from "../layouts/BaseLayout.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { site, faqPageJsonLd } from "../data/site";

const faqs = [
  {
    q: "Is the consultation really free, with no obligation?",
    a: "Yes. We'll talk about your family, your goals, and your questions. You'll leave with a clear idea of what a plan would involve and what it would cost — there's never any pressure to move forward.",
  },
  {
    q: "How quickly will I hear back?",
    a: `We respond to every message personally, typically within one business day. If it's urgent, calling ${site.phone} directly is the fastest way to reach us.`,
  },
  {
    q: "Do I need to prepare anything before we talk?",
    a: "No — just show up with your questions. If it's helpful, a rough sense of your assets and family situation can speed things along, but it's not required for a first conversation.",
  },
  {
    q: "Do you meet clients in person?",
    a: "Yes, when it makes sense — at your home or another convenient location anywhere in Wisconsin. Many clients prefer meeting by video or phone instead, and both options work equally well.",
  },
];

const contactFaqJsonLd = faqPageJsonLd(faqs);

const errorMessages = {
  missing: "Please fill in your name, email, and message before submitting.",
  send: "Something went wrong sending your message. Please try again, or call or email us directly.",
  config: "This form isn't fully set up yet. Please call or email us directly in the meantime.",
};
---

<BaseLayout
  title="Contact a Wisconsin Estate Planning Attorney"
  description={`Schedule a free, no-pressure consultation with ${site.firmName}. Serving clients virtually and in person throughout Wisconsin.`}
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(contactFaqJsonLd)} />
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <p class="text-sm font-semibold tracking-[0.2em] text-gold-700 uppercase">Contact</p>
    <h1 class="font-display mt-3 text-4xl font-semibold text-navy-900">Let's Talk About Protecting Your Family</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-700">
      Reach out by phone, email, or the form below. There's no pressure and no obligation — just a
      conversation about your family and what a plan built around them would look like.
    </p>

    <div class="mt-12 grid gap-10 md:grid-cols-[1fr_1.2fr]">
      <div class="space-y-6">
        <div class="rounded-sm border border-navy-900/10 bg-cream-200 p-6">
          <h2 class="font-display text-sm font-semibold tracking-wide text-navy-900 uppercase">Phone</h2>
          <a href={site.phoneHref} class="mt-2 block text-lg font-semibold text-gold-700 hover:text-gold-600">
            {site.phone}
          </a>
        </div>
        <div class="rounded-sm border border-navy-900/10 bg-cream-200 p-6">
          <h2 class="font-display text-sm font-semibold tracking-wide text-navy-900 uppercase">Email</h2>
          <a href={`mailto:${site.email}`} class="mt-2 block text-lg font-semibold text-gold-700 hover:text-gold-600">
            {site.email}
          </a>
        </div>
        <div class="rounded-sm border border-navy-900/10 bg-cream-200 p-6">
          <h2 class="font-display text-sm font-semibold tracking-wide text-navy-900 uppercase">Hours</h2>
          <p class="mt-2 text-ink-700">{site.hours}</p>
        </div>
        <div class="rounded-sm border border-navy-900/10 bg-cream-200 p-6">
          <h2 class="font-display text-sm font-semibold tracking-wide text-navy-900 uppercase">How We Meet</h2>
          <p class="mt-2 text-ink-700">{site.serviceArea}. {site.meetingOptions}</p>
        </div>
      </div>

      <form
        class="space-y-5 rounded-sm border border-navy-900/10 bg-cream-100 p-8 shadow-sm"
        action="/api/contact"
        method="POST"
      >
        <p class="text-sm text-ink-700">
          Fill this out and we'll reach out to schedule your free consultation — usually within one
          business day.
        </p>

        <p
          id="contact-form-error"
          role="alert"
          hidden
          class="rounded-sm border border-red-900/20 bg-red-50 px-4 py-3 text-sm text-red-900"
        ></p>

        <div>
          <label for="name" class="block text-sm font-semibold text-navy-900">Name</label>
          <input
            type="text"
            id="name"
            name="name"
            required
            autocomplete="name"
            class="mt-2 w-full rounded-sm border border-navy-900/20 bg-cream-100 px-4 py-2.5 text-ink-900 focus:border-gold-600 focus:ring-1 focus:ring-gold-600 focus:outline-none"
          />
        </div>
        <div>
          <label for="email" class="block text-sm font-semibold text-navy-900">Email</label>
          <input
            type="email"
            id="email"
            name="email"
            required
            autocomplete="email"
            class="mt-2 w-full rounded-sm border border-navy-900/20 bg-cream-100 px-4 py-2.5 text-ink-900 focus:border-gold-600 focus:ring-1 focus:ring-gold-600 focus:outline-none"
          />
        </div>
        <div>
          <label for="phone" class="block text-sm font-semibold text-navy-900">Phone (optional)</label>
          <input
            type="tel"
            id="phone"
            name="phone"
            autocomplete="tel"
            class="mt-2 w-full rounded-sm border border-navy-900/20 bg-cream-100 px-4 py-2.5 text-ink-900 focus:border-gold-600 focus:ring-1 focus:ring-gold-600 focus:outline-none"
          />
        </div>
        <div>
          <label for="message" class="block text-sm font-semibold text-navy-900">How can we help?</label>
          <textarea
            id="message"
            name="message"
            rows="5"
            required
            class="mt-2 w-full rounded-sm border border-navy-900/20 bg-cream-100 px-4 py-2.5 text-ink-900 focus:border-gold-600 focus:ring-1 focus:ring-gold-600 focus:outline-none"
          ></textarea>
        </div>

        <div class="absolute left-[-9999px] h-px w-px overflow-hidden" aria-hidden="true">
          <label for="company">Leave this field blank</label>
          <input type="text" id="company" name="company" tabindex="-1" autocomplete="off" />
        </div>

        <button
          type="submit"
          class="w-full rounded-sm bg-navy-900 px-6 py-3 text-sm font-semibold text-cream-100 transition-colors hover:bg-navy-700"
        >
          Schedule Your Consultation
        </button>
      </form>
    </div>

    <script is:inline define:vars={{ errorMessages }}>
      const params = new URLSearchParams(window.location.search);
      const code = params.get("error");
      if (code && errorMessages[code]) {
        const el = document.getElementById("contact-form-error");
        el.textContent = errorMessages[code];
        el.hidden = false;
        el.scrollIntoView({ behavior: "smooth", block: "center" });
      }
    </script>

    <div class="mt-16 max-w-4xl">
      <h2 class="font-display text-2xl font-semibold text-navy-900">Before You Reach Out</h2>
      <div class="mt-6">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>
  </section>
</BaseLayout>
