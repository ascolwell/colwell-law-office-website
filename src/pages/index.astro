---
import { Image } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site, practiceAreas } from "../data/site";
import logo from "../assets/logo.png";
---

<BaseLayout
  title="Estate Planning Attorney"
  description={`${site.firmName} helps individuals and families in Wisconsin plan their wills, trusts, and powers of attorney with the guidance of an attorney who is also a CPA.`}
>
  <section class="bg-navy-950 text-cream-100">
    <div class="mx-auto grid max-w-6xl gap-10 px-6 py-20 md:grid-cols-2 md:items-center md:py-28">
      <div>
        <p class="text-sm font-semibold tracking-[0.2em] text-gold-400 uppercase">Estate Planning Attorney</p>
        <h1 class="font-display mt-4 text-4xl leading-tight font-semibold text-cream-100 md:text-5xl">
          {site.tagline}
        </h1>
        <p class="mt-6 max-w-xl text-lg text-navy-100/90">
          {site.firmName} helps individuals and families put a clear, thoughtfully built estate
          plan in place — wills, trusts, and powers of attorney — so the people you love are
          protected and your wishes are honored.
        </p>
        <div class="mt-8 flex flex-wrap gap-4">
          <a
            href="/contact/"
            class="rounded-sm bg-gold-500 px-6 py-3 text-sm font-semibold text-navy-950 transition-colors hover:bg-gold-400"
          >
            Schedule a Consultation
          </a>
          <a
            href="/practice-areas/"
            class="rounded-sm border border-cream-100/30 px-6 py-3 text-sm font-semibold text-cream-100 transition-colors hover:border-cream-100/60"
          >
            View Practice Areas
          </a>
        </div>
      </div>
      <div class="justify-self-center">
        <Image
          src={logo}
          alt={`${site.firmName} seal`}
          width={280}
          height={280}
          class="h-56 w-56 invert md:h-72 md:w-72"
        />
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="max-w-2xl">
      <p class="text-sm font-semibold tracking-[0.2em] text-gold-700 uppercase">Why Colwell Law Office</p>
      <h2 class="font-display mt-3 text-3xl font-semibold text-navy-900">An attorney who also thinks like your accountant</h2>
      <p class="mt-4 text-ink-700">
        {site.attorneyName} is both a licensed attorney and a Certified Public Accountant — a
        combination that's rare in estate planning. That means your plan is built not just to be
        legally sound, but to hold up financially: tax-aware, practical, and tailored to how your
        assets actually work.
      </p>
    </div>
  </section>

  <section class="bg-cream-200 py-16">
    <div class="mx-auto max-w-6xl px-6">
      <div class="flex items-end justify-between gap-4">
        <h2 class="font-display text-3xl font-semibold text-navy-900">Practice Areas</h2>
        <a href="/practice-areas/" class="hidden text-sm font-semibold text-gold-700 hover:text-gold-600 md:inline">
          See all practice areas &rarr;
        </a>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          practiceAreas.map((area) => (
            <a
              href={`/practice-areas/${area.slug}/`}
              class="group block rounded-sm border border-navy-900/10 bg-cream-100 p-8 transition-shadow hover:shadow-lg"
            >
              <h3 class="font-display text-xl font-semibold text-navy-900 group-hover:text-gold-700">{area.name}</h3>
              <p class="mt-3 text-sm text-ink-700">{area.short}</p>
              <span class="mt-4 inline-block text-sm font-semibold text-gold-700">Learn more &rarr;</span>
            </a>
          ))
        }
      </div>
      <a href="/practice-areas/" class="mt-8 inline-block text-sm font-semibold text-gold-700 hover:text-gold-600 md:hidden">
        See all practice areas &rarr;
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-6 py-16">
    <div class="grid gap-10 rounded-sm bg-navy-900 px-8 py-12 text-cream-100 md:grid-cols-[2fr_1fr] md:items-center md:px-14">
      <div>
        <h2 class="font-display text-2xl font-semibold md:text-3xl">Ready to put a plan in place?</h2>
        <p class="mt-3 text-navy-100/90">
          Reach out today to schedule a consultation with {site.attorneyName} and start building a
          plan for your legacy.
        </p>
      </div>
      <div class="flex flex-col gap-3 md:items-end">
        <a
          href={site.phoneHref}
          class="rounded-sm bg-gold-500 px-6 py-3 text-center text-sm font-semibold text-navy-950 hover:bg-gold-400"
        >
          Call {site.phone}
        </a>
        <a
          href="/contact/"
          class="rounded-sm border border-cream-100/30 px-6 py-3 text-center text-sm font-semibold text-cream-100 hover:border-cream-100/60"
        >
          Send a Message
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
