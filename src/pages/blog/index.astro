---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import CtaBanner from "../../components/CtaBanner.astro";
import { site } from "../../data/site";

const posts = (await getCollection("blog", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BaseLayout
  title="Wisconsin Estate Planning Blog"
  description={`Plain-English articles on wills, living trusts, probate, and estate planning for Wisconsin families, from ${site.firmName}.`}
>
  <section class="mx-auto max-w-4xl px-6 py-16 md:py-20">
    <p class="text-sm font-semibold tracking-[0.2em] text-gold-700 uppercase">Blog</p>
    <h1 class="font-display mt-3 text-4xl font-semibold text-navy-900">Insights on Estate Planning</h1>
    <p class="mt-4 text-ink-700">
      Practical, plain-English thoughts on wills, trusts, and planning for your family's future —
      no jargon required.
    </p>

    <div class="mt-12 space-y-8">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.slug}/`}
            class="block rounded-sm border border-navy-900/10 bg-cream-200 p-7 transition-shadow hover:shadow-lg"
          >
            <time datetime={post.data.pubDate.toISOString()} class="text-xs font-semibold tracking-wide text-gold-700 uppercase">
              {dateFormatter.format(post.data.pubDate)}
            </time>
            <h2 class="font-display mt-2 text-2xl font-semibold text-navy-900">{post.data.title}</h2>
            <p class="mt-2 text-ink-700">{post.data.description}</p>
            <span class="mt-3 inline-block text-sm font-semibold text-gold-700">Read more &rarr;</span>
          </a>
        ))
      }
      {
        posts.length === 0 && (
          <p class="text-ink-500">No posts yet — check back soon.</p>
        )
      }
    </div>

    <div class="mt-14">
      <CtaBanner
        heading="Have a Question a Blog Post Can't Answer?"
        subtext="Skip the search and get a straight answer. Schedule a free, no-pressure consultation."
      />
    </div>
  </section>
</BaseLayout>
