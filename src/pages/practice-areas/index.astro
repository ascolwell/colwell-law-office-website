---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { site, practiceAreas } from "../../data/site";
---

<BaseLayout
  title="Practice Areas"
  description={`Estate planning services offered by ${site.firmName}, including wills, trusts, and powers of attorney.`}
>
  <section class="mx-auto max-w-6xl px-6 py-16 md:py-20">
    <p class="text-sm font-semibold tracking-[0.2em] text-gold-700 uppercase">Practice Areas</p>
    <h1 class="font-display mt-3 max-w-2xl text-4xl font-semibold text-navy-900">
      Estate planning built around your family and your future
    </h1>
    <p class="mt-4 max-w-2xl text-ink-700">
      {site.firmName} focuses on the core documents every solid estate plan needs. Each one can
      stand on its own or work together as part of a complete plan.
    </p>

    <div class="mt-12 grid gap-6 md:grid-cols-3">
      {
        practiceAreas.map((area) => (
          <a
            href={`/practice-areas/${area.slug}/`}
            class="group flex flex-col rounded-sm border border-navy-900/10 bg-cream-200 p-8 transition-shadow hover:shadow-lg"
          >
            <h2 class="font-display text-xl font-semibold text-navy-900 group-hover:text-gold-700">{area.name}</h2>
            <p class="mt-3 flex-1 text-sm text-ink-700">{area.short}</p>
            <span class="mt-4 inline-block text-sm font-semibold text-gold-700">Learn more &rarr;</span>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>
