---
import BaseLayout from "../layouts/BaseLayout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import FaqAccordion from "../components/FaqAccordion.astro";
import { site, faqPageJsonLd } from "../data/site";

const faqs = [
  {
    q: "Is it safe to pay online?",
    a: "Yes. Payments are processed securely through Square, a widely used, PCI-compliant payment processor. Colwell Law Office never sees or stores your card details.",
  },
  {
    q: "What payment methods are accepted?",
    a: "Square accepts all major credit and debit cards.",
  },
  {
    q: "I have a question about my invoice or the amount I owe. Who do I contact?",
    a: `Reach out before submitting a payment if anything about your invoice is unclear. Call ${site.phone} or email ${site.email} and we'll sort it out.`,
  },
  {
    q: "Will I get a receipt?",
    a: "Yes, Square automatically emails a receipt to the email address you provide at checkout.",
  },
];

const paymentFaqJsonLd = faqPageJsonLd(faqs);
---

<BaseLayout
  title="Make a Payment | Colwell Law Office, LLC"
  description="Securely pay your invoice online. Colwell Law Office accepts credit and debit card payments through Square."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(paymentFaqJsonLd)} />
  <section class="mx-auto max-w-4xl px-6 py-16 md:py-20">
    <p class="text-sm font-semibold tracking-[0.2em] text-gold-700 uppercase">Billing</p>
    <h1 class="font-display mt-3 text-4xl font-semibold text-navy-900">Make a Payment</h1>
    <p class="mt-4 max-w-2xl text-lg text-ink-700">
      Existing clients can securely pay an invoice online in just a couple of minutes. Have your
      invoice handy, then click below to complete your payment through our secure payment
      partner, Square.
    </p>

    <div class="mt-10 rounded-sm border border-navy-900/10 bg-cream-200 p-8 text-center md:p-10">
      <h2 class="font-display text-xl font-semibold text-navy-900">Ready to Pay Your Invoice?</h2>
      <p class="mt-2 text-ink-700">You'll be taken to Square's secure checkout to complete your payment.</p>
      <a
        href={site.paymentLink}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-6 inline-block rounded-sm bg-gold-500 px-8 py-3.5 text-sm font-semibold text-navy-950 transition-colors hover:bg-gold-400"
      >
        Pay Your Invoice Securely &rarr;
      </a>
      <p class="mt-4 flex items-center justify-center gap-2 text-xs text-ink-500">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4 text-gold-700">
          <path fill-rule="evenodd" d="M10 1a4.5 4.5 0 00-4.5 4.5V9H5a2 2 0 00-2 2v6a2 2 0 002 2h10a2 2 0 002-2v-6a2 2 0 00-2-2h-.5V5.5A4.5 4.5 0 0010 1zm3 8V5.5a3 3 0 10-6 0V9h6z" clip-rule="evenodd" />
        </svg>
        Secure checkout powered by Square
      </p>
    </div>

    <div class="mt-10 grid gap-6 md:grid-cols-2">
      <div class="rounded-sm border border-navy-900/10 bg-cream-100 p-6">
        <h2 class="font-display text-sm font-semibold tracking-wide text-navy-900 uppercase">Accepted Payment Methods</h2>
        <p class="mt-2 text-sm text-ink-700">All major credit and debit cards, processed securely through Square.</p>
      </div>
      <div class="rounded-sm border border-navy-900/10 bg-cream-100 p-6">
        <h2 class="font-display text-sm font-semibold tracking-wide text-navy-900 uppercase">Questions About Your Bill?</h2>
        <p class="mt-2 text-sm text-ink-700">
          Contact us before paying if anything on your invoice needs clarifying — we're happy to help.
        </p>
      </div>
    </div>

    <div class="mt-14">
      <h2 class="font-display text-2xl font-semibold text-navy-900">Payment FAQ</h2>
      <div class="mt-6">
        <FaqAccordion faqs={faqs} />
      </div>
    </div>

    <div class="mt-14">
      <CtaBanner
        heading="Questions About Your Invoice?"
        subtext="If anything about your bill isn't clear, reach out before you pay and we'll get it sorted."
        primaryLabel="Contact Us"
      />
    </div>
  </section>
</BaseLayout>
